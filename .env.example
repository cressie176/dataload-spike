# Connection to the throwaway harness container (see docker-compose.yml).
PGHOST=localhost
PGPORT=5433
PGUSER=harness
PGPASSWORD=harness
PGDATABASE=parkdb

# Image the harness runs against. Defaults to the pinned published tag;
# override to a locally-built content-hash tag when you've changed schema/seed.
# Run `npm run image:hash` to compute the current tag from (migrations + seed).
HARNESS_IMAGE=parkdata:latest
